<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="egx.relab_app.ui.home.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_orderListFragment"
            app:destination="@id/orderListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="egx.relab_app.ui.orders.ProfileFragment"
        android:label="Профиль"
        tools:layout="@layout/fragment_profile" >
        <argument
            android:name="userId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/orderListFragment"
        android:name="egx.relab_app.ui.orders.OrderListFragment"
        android:label="Заказы"
        tools:layout="@layout/fragment_orders">



        <action
            android:id="@+id/action_orderListFragment_to_orderFormFragment"
            app:destination="@id/orderFormFragment" />


        <action
            android:id="@+id/action_orderListFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />

    </fragment>
    
    <fragment
        android:id="@+id/nav_customers"
        android:name="egx.relab_app.ui.customers.CustomerListFragment"
        android:label="База Клиентов"
        tools:layout="@layout/fragment_customer_list" >
        <action
            android:id="@+id/action_customerListFragment_to_customerDetailFragment"
            app:destination="@id/customerDetailFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
    </fragment>
        
    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="egx.relab_app.ui.customers.CustomerDetailFragment"
        android:label="Карточка клиента"
        tools:layout="@layout/fragment_customer_detail">
        <argument
            android:name="customer"
            app:argType="egx.relab_app.models.Customer" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="egx.relab_app.ui.orders.AnalyticsFragment"
        android:label="Аналитика"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="egx.relab_app.ui.settings.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/toolsFragment"
        android:name="egx.relab_app.ui.tools.ToolsFragment"
        android:label="Инструменты"
        tools:layout="@layout/fragment_tools" />

    <fragment
        android:id="@+id/orderFormFragment"
        android:name="egx.relab_app.ui.orders.OrderFormFragment"
        android:label="Форма заказа"
        tools:layout="@layout/fragment_order_create">

        <argument
            android:name="order"
            app:argType="egx.relab_app.models.Order"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="egx.relab_app.ui.orders.OrderDetailFragment"
        android:label="Детали заказа"
        tools:layout="@layout/fragment_order_detail">

        <argument
            android:name="order"
            app:argType="egx.relab_app.models.Order" />
        <action
            android:id="@+id/action_orderDetailFragment_to_orderFormFragment"
            app:destination="@id/orderFormFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="egx.relab_app.ui.orders.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_orderListFragment"
            app:destination="@id/nav_home" />
    </fragment>



</navigation>
