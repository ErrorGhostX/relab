<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="egx.relab_app.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_gallery"
        android:name="egx.relab_app.ui.gallery.GalleryFragment"
        android:label="@string/menu_gallery"
        tools:layout="@layout/fragment_gallery" />

    <fragment
        android:id="@+id/nav_slideshow"
        android:name="egx.relab_app.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />

    <fragment
        android:id="@+id/orderListFragment"
        android:name="egx.relab_app.ui.orders.OrderListFragment"
        android:label="Заказы"
        tools:layout="@layout/fragment_orders">

        <action
            android:id="@+id/action_orderListFragment_to_createOrderFragment"
            app:destination="@id/createOrderFragment" />


        <action
            android:id="@+id/action_orderListFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />

    </fragment>


    <fragment
        android:id="@+id/createOrderFragment"
        android:name="egx.relab_app.ui.orders.OrderCreateFragment"
        android:label="Создать заказ"
        tools:layout="@layout/fragment_create_order" />

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="egx.relab_app.ui.orders.OrderDetailFragment"
        android:label="Детали заказа"
        tools:layout="@layout/fragment_order_detail">

        <argument
            android:name="order"
            app:argType="egx.relab_app.models.Order" />
    </fragment>


</navigation>
