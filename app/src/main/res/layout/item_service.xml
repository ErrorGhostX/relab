<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="0dp">

    <!-- Описание + цена: занимает всё свободное место -->
    <TextView
        android:id="@+id/tvServiceDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/DetailTextStyleBlack"/>

    <!-- Кнопка «корзина» -->
    <ImageButton
        android:id="@+id/btnDeleteService"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Удалить услугу"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/trash_can_svgrepo_com"
        android:tint="@color/error_red" />


</LinearLayout>
