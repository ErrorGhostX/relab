<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/gray_50"
    app:strokeColor="@color/gray_200"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/orderImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Sync Pending Badge (List Mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/syncPendingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/error_red"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="@id/orderImage"
            app:layout_constraintBottom_toBottomOf="@id/orderImage"
            android:layout_marginStart="-4dp"
            android:layout_marginBottom="-4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:padding="2dp"
                android:src="@android:drawable/stat_notify_sync"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Info -->
        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/orderImage"
            app:layout_constraintEnd_toStartOf="@id/rightLayout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/orderNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Замена дисплея"
                android:textStyle="bold"
                android:textColor="@color/text_premium_primary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iPhone 13 Pro Max"
                android:textColor="@color/text_premium_secondary"
                android:textSize="12sp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/orderIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#12345 | 25.04"
                android:textColor="@color/text_premium_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/orderCreatedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Александр"
                android:textColor="@color/text_premium_secondary"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/orderStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="НОВЫЙ"
                android:textColor="@color/accent_premium"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_glass_card"
                android:backgroundTint="@color/gray_100" />
        </LinearLayout>

        <!-- Right Side -->
        <LinearLayout
            android:id="@+id/rightLayout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/orderDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.04"
                android:textColor="@color/text_premium_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/createdByLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/createdByAvatar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    android:src="@mipmap/ic_launcher_round" />
            </LinearLayout>
        </LinearLayout>

        <!-- Public Indicator -->
        <TextView
            android:id="@+id/badgePublic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Complexity Indicator (List mode) -->
        <LinearLayout
            android:id="@+id/complexityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivComplexityIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/accent_premium" />

            <TextView
                android:id="@+id/tvComplexityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="30%"
                android:textColor="@color/text_premium_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
