<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:paddingTop="58dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Блок с картинкой растянутый на всю ширину -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_200"
                app:strokeWidth="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photosViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Левая стрелка -->
            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_play"
                android:rotation="180"
                android:contentDescription="Previous"
                app:tint="@color/black"
                android:elevation="8dp"/>

            <!-- Правая стрелка -->
            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Next"
                app:tint="@color/black"
                android:elevation="8dp"/>
        </FrameLayout>




    <!-- Остальные блоки с паддингом -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">


        <!-- Блок с ID и кнопками -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="382dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Кнопки действия -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonAddService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/tools_svgrepo_com"
                        android:tint="@color/white"
                        app:backgroundTint="#3F51B5" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonPrint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/document_send_svgrepo_com"
                        android:tint="@color/white"
                        app:backgroundTint="#3F51B5" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/pencil_file_svgrepo_com"
                        android:tint="@color/white"
                        app:backgroundTint="#3F51B5" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/trash_can_svgrepo_com"
                        android:tint="@color/white"
                        app:backgroundTint="#F44336" />
                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/gray_900" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/orderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="ID: 123"
                        android:textColor="@color/gray_900"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/orderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Номер заказа: 12345"
                        android:textColor="@color/gray_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <!-- Кто создал -->
                <LinearLayout
                    android:layout_width="347dp"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- "Создан:" -->
                    <TextView
                        android:id="@+id/orderCreatedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Создан:"
                        android:textColor="@color/gray_900"
                        android:textSize="16sp"
                        android:textStyle="bold"/>


                    <!-- Аватар -->
                    <ImageView
                        android:id="@+id/createdByAvatar"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher_round" />

                    <!-- ФИО / username -->
                    <TextView
                        android:id="@+id/orderCreatedName"
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:text="Иван Иванов"
                        android:textColor="@color/gray_900"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Основная информация о заказе -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Основная информация"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/gray_900"
                    android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/customer"
                    android:text="Клиент: Иван Иванов"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/contactInfo"
                    android:text="Контакты: 888-123-45-67"
                    android:textColor="@color/gray_900"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/extraInfo"
                    android:text="Доп. инфо: Срочно"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/telegram"
                    android:text="Мессенджер: @ivan_telegram"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingBottom="2dp"
                    android:drawablePadding="4dp"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Информация об устройстве -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DetailHeaderTextStyleBlack"
                    android:text="Устройство"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/deviceName"
                    android:text="Название: iPhone 12"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/deviceType"
                    android:text="Тип: Смартфон"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/manufacturer"
                    android:text="Производитель: Apple"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/model"
                    android:text="Модель: 12 Pro"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/kit"
                    android:text="Комплектация: Зарядка, наушники"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Описание и статус -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/description"
                    android:text="Описание: Не включается"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/date"
                    android:text="Дата: 2025-05-11"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/orderType"
                    android:text="Тип заказа: Ремонт"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/status"
                    android:text="Статус: В процессе"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция услуг -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Оказанные услуги"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="12dp"/>

                <!-- Контейнер для списка услуг -->
                <LinearLayout
                    android:id="@+id/servicesContainer"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    </LinearLayout>
</ScrollView>
