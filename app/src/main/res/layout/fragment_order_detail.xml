<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Карточка с изображением -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="8dp"
            card_view:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/orderImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image" />
        </androidx.cardview.widget.CardView>

        <!-- Блок с ID и кнопками -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/orderId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ID: 123"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <!-- Кнопки действия -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonAddService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="@android:color/white"
                    app:backgroundTint="@color/purple_200"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonPrint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_set_as"
                    android:tint="@android:color/white"
                    app:backgroundTint="@color/purple_200"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="@android:color/white"
                    app:backgroundTint="@color/purple_200"/>
            </LinearLayout>

            <!-- Кто создал -->
            <TextView
                android:id="@+id/createdBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Создан: Иван Иванов"
                android:paddingTop="4dp"
                android:textAppearance="@style/DetailTextStyle"/>
        </LinearLayout>

        <!-- Поля заказа -->
        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/orderNumber"
            android:text="Номер заказа: 12345"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/customer"
            android:text="Клиент: Иван Иванов"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/contactInfo"
            android:text="Контакты: 888-123-45-67"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/extraInfo"
            android:text="Доп. инфо: Срочно"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/telegram"
            android:text="Telegram: @ivan_telegram"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginVertical="12dp" />

        <!-- Блок устройства -->
        <TextView
            style="@style/DetailTextStyle"
            android:textStyle="bold"
            android:text="Устройство"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/deviceName"
            android:text="Название: iPhone 12"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/deviceType"
            android:text="Тип: Смартфон"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/manufacturer"
            android:text="Производитель: Apple"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/model"
            android:text="Модель: 12 Pro"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/kit"
            android:text="Комплектация: Зарядка, наушники"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginVertical="12dp" />

        <!-- Описание и статус -->
        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/description"
            android:text="Описание: Не включается"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/date"
            android:text="Дата: 2025-05-11"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/orderType"
            android:text="Тип заказа: Ремонт"/>

        <TextView
            style="@style/DetailTextStyle"
            android:id="@+id/status"
            android:text="Статус: В процессе"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginVertical="12dp" />

        <!-- Секция “Оказанные услуги” -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оказанные услуги:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="16dp"/>

        <!-- Контейнер для списка услуг: здесь мы динамически добавим TextView -->
        <LinearLayout
            android:id="@+id/servicesContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"/>
    </LinearLayout>
</ScrollView>
