<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:paddingTop="58dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Блок с картинкой растянутый на всю ширину -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/gray_200"
                app:strokeWidth="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photosViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnDeletePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:contentDescription="Удалить фото"
                    android:elevation="5dp"
                    android:src="@drawable/trash_can_svgrepo_com"
                    app:backgroundTint="@color/error_red"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Левая стрелка -->
            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_play"
                android:rotation="180"
                android:contentDescription="Previous"
                app:tint="@android:color/holo_blue_dark"
                android:elevation="8dp"/>

            <!-- Правая стрелка -->
            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Next"
                app:tint="@android:color/holo_blue_dark"
                android:elevation="8dp"/>
            
            <!-- Кнопка удаления текущего фото -->
        </FrameLayout>




    <!-- Остальные блоки с паддингом -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">


        <!-- Блок с ID и кнопками -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonAddService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:src="@drawable/tools_svgrepo_com"
                        app:tint="@color/white"
                        app:backgroundTint="#3F51B5"
                        app:fabSize="mini" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonPrint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:src="@drawable/document_send_svgrepo_com"
                        app:tint="@color/white"
                        app:backgroundTint="#3F51B5"
                        app:fabSize="mini" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:src="@drawable/pencil_file_svgrepo_com"
                        app:tint="@color/white"
                        app:backgroundTint="#3F51B5"
                        app:fabSize="mini" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonAiHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:src="@drawable/ai_magic_wand_svgrepo_com"
                        app:tint="@color/white"
                        app:backgroundTint="#9C27B0"
                        app:fabSize="mini" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/buttonDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:src="@drawable/trash_can_svgrepo_com"
                        app:tint="@color/white"
                        app:backgroundTint="#F44336"
                        app:fabSize="mini" />
                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/gray_900" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/orderId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="ID: 123"
                            android:textColor="@color/gray_900"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/orderNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Название заказа"
                            android:textColor="@color/gray_900"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Статус заказа (Бейдж) -->
                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="НОВЫЙ"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:background="@color/gray_800" />
                </LinearLayout>


                <!-- Кто создал -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Создан: "
                        android:textColor="@color/gray_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/createdByAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher_round" />

                    <TextView
                        android:id="@+id/orderCreatedName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Загрузка..."
                        android:textColor="@color/gray_900"
                        android:textSize="14sp" />
                </LinearLayout>
                
                <!-- Информация об исполнителе и коллаборации (ПЕРЕНЕСЕНО НАВЕРХ) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/gray_900" />

                <LinearLayout
                    android:id="@+id/layoutAssignedTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Исполнитель: "
                        android:textColor="@color/gray_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/assignedToAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher_round" />

                    <TextView
                        android:id="@+id/assignedToName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Не назначен"
                        android:textColor="@color/gray_900"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/labelPublicOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Общий заказ"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/collaboratorsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Кнопки управления коллаборацией (сделаем две строки если нужно) -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layoutCollabButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexDirection="row"
                    app:flexWrap="wrap"
                    app:justifyContent="center"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAcceptOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Принять"
                        android:textSize="11sp"
                        app:backgroundTint="#4CAF50"
                        app:cornerRadius="8dp"
                        android:layout_margin="2dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRejectAcceptance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Отклонить"
                        android:textSize="11sp"
                        app:backgroundTint="#F44336"
                        app:cornerRadius="8dp"
                        android:layout_margin="2dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonInvite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пригласить"
                        android:textSize="11sp"
                        app:backgroundTint="#3F51B5"
                        app:cornerRadius="8dp"
                        android:layout_margin="2dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonLeaveOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Покинуть"
                        android:textSize="11sp"
                        app:backgroundTint="#FF9800"
                        app:cornerRadius="8dp"
                        android:layout_margin="2dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonReleaseOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Отказаться"
                        android:textSize="11sp"
                        app:backgroundTint="#607D8B"
                        app:cornerRadius="8dp"
                        android:layout_margin="2dp"
                        android:visibility="gone" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Основная информация о заказе -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Основная информация"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/gray_900"
                    android:layout_marginBottom="12dp" />

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/gray_900" />
                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/customer"
                    android:text="Клиент: Иван Иванов"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/contactInfo"
                    android:text="Контакты: 888-123-45-67"
                    android:textColor="@color/gray_900"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/extraInfo"
                    android:text="Доп. инфо: Срочно"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/messenger"
                    android:text="Мессенджер: @ivan_messenger"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingBottom="2dp"
                    android:drawablePadding="4dp"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Информация об устройстве -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DetailHeaderTextStyleBlack"
                    android:text="Устройство"
                    android:textColor="@color/gray_900"/>
                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/gray_900" />


                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/deviceType"
                    android:text="Тип: Смартфон"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/manufacturer"
                    android:text="Производитель: Apple"
                    android:textColor="@color/gray_900"/>
                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/deviceName"
                    android:text="Модель: iPhone 12"
                    android:textColor="@color/gray_900"/>


                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/kit"
                    android:text="Комплектация: Зарядка, наушники"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Описание и статус -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/description"
                    android:text="Описание: Не включается"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/date"
                    android:text="Дата: 2025-05-11"
                    android:textColor="@color/gray_900"/>

                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/orderType"
                    android:text="Тип заказа: Ремонт"
                    android:textColor="@color/gray_900"/>


                <TextView
                    style="@style/DetailTextStyleBlack"
                    android:id="@+id/orderComplexity"
                    android:text="Сложность: не рассчитана"
                    android:textColor="@color/gray_900"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Секция услуг -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/gray_200"
            app:strokeColor="@color/gray_900"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Оказанные услуги"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="12dp"/>

                <!-- Контейнер для списка услуг -->
                <LinearLayout
                    android:id="@+id/servicesContainer"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    </LinearLayout>
</ScrollView>
