<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/gray_200"
    app:strokeColor="@color/gray_900"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/orderImage"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="@color/gray_200" />

        <TextView
            android:id="@+id/orderIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123"
            android:textStyle="bold"
            android:textColor="@color/gray_900"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/orderNumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Номер: 12345"
            android:textStyle="bold"
            android:textColor="@color/gray_800"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/deviceNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Устройство: Телефон"
            android:textColor="@color/gray_900"
            android:layout_marginTop="4dp" />

        <!-- Создатель с иконкой -->
        <LinearLayout
            android:id="@+id/createdByLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/createdByAvatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="Аватар создателя" />

            <TextView
                android:id="@+id/orderCreatedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Создан: Пользователь"
                android:textColor="@color/gray_700"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Статус внизу -->
        <TextView
            android:id="@+id/orderStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус: В процессе"
            android:textColor="@color/gray_800"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
