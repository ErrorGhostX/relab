<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пульт управления"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- КОРПУС ПУЛЬТА -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/remote_body_bg"
            android:padding="24dp"
            android:elevation="12dp"
            android:layout_marginBottom="32dp">

            <!-- Кнопка питания -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPower"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="#D32F2F"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="28dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Кнопка Source -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSource"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="SOURCE"
                android:textSize="10sp"
                android:textColor="#BDBDBD"
                android:backgroundTint="#333333"
                app:cornerRadius="20dp"
                app:strokeColor="#4A4A4A"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="@id/btnPower"
                app:layout_constraintBottom_toBottomOf="@id/btnPower"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Джойстик навигации -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/joystickContainer"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/btnPower"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/remote_button_bg"
                    android:alpha="0.2" />

                <ImageButton
                    android:id="@+id/btnUp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/arrow_up_float"
                    android:background="@drawable/remote_button_bg"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/btnDown"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="@drawable/remote_button_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="@drawable/remote_button_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_media_next"
                    android:background="@drawable/remote_button_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOk"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="OK"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="@color/teal_700"
                    app:cornerRadius="36dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Громкость и Каналы -->
            <LinearLayout
                android:id="@+id/volumeChannelContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/joystickContainer">

                <!-- VOL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#2A2A2A"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnVolUp"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_input_add"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#BDBDBD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOL"
                        android:textColor="#757575"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"/>

                    <ImageButton
                        android:id="@+id/btnVolDown"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/button_onoff_indicator_off"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#BDBDBD" />
                </LinearLayout>

                <!-- MUTE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMute"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:backgroundTint="#333333"
                        app:icon="@android:drawable/ic_lock_silent_mode"
                        app:iconTint="#D32F2F"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:cornerRadius="24dp"
                        app:strokeColor="#4A4A4A"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- CH -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#2A2A2A"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnChannelUp"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/arrow_up_float"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#BDBDBD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CH"
                        android:textColor="#757575"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"/>

                    <ImageButton
                        android:id="@+id/btnChannelDown"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#BDBDBD" />
                </LinearLayout>

            </LinearLayout>

            <!-- Доп кнопки снизу -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/volumeChannelContainer">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="BACK"
                    android:textSize="8sp"
                    android:textColor="#9E9E9E"
                    android:backgroundTint="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHome"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    android:textSize="8sp"
                    android:textColor="#9E9E9E"
                    android:backgroundTint="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInput"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="INPUT"
                    android:textSize="8sp"
                    android:textColor="#9E9E9E"
                    android:backgroundTint="#333333"
                    app:cornerRadius="4dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- БЛОК ИНСТРУКЦИЙ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Инструкция для бабушки"
                    android:textColor="@color/teal_700"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearSequence"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Сброс"
                        android:textColor="#D32F2F"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateInstruction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Создать пошагово"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/teal_700"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выбранные действия:"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/textSequence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F9F9F9"
                    android:padding="12dp"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:hint="Тут появятся нажатые кнопки..."
                    android:minHeight="48dp"
                    android:focusable="false"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/textInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E0F2F1"
                    android:padding="16dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:hint="Готовая инструкция будет здесь"
                    android:minLines="4"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ОТПРАВИТЬ ЧЕРЕЗ WHATSAPP / SMS"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/teal_700"
                    android:enabled="false"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

